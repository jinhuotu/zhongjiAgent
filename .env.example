# Application
APP_NAME=zhongji-agent
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
# CORS：开发可用 *（任意 Origin）；生产请改为前端域名白名单，逗号分隔
# 例：CORS_ORIGINS=https://ecm.example.com,https://www.example.com
CORS_ORIGINS=*

# Server
API_HOST=0.0.0.0
API_PORT=8000
AI_HOST=0.0.0.0
AI_PORT=8001
INGEST_HOST=0.0.0.0
INGEST_PORT=8002
MODEL_HOST=0.0.0.0
MODEL_PORT=8003

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=admin
MYSQL_DATABASE=zhongji_agent
DATABASE_URL=mysql+asyncmy://admin:admin@127.0.0.1:3306/zhongji_agent?charset=utf8mb4

# Redis（Docker Compose 默认宿主机端口 16379）
REDIS_URL=redis://127.0.0.1:16379/0

# Chat 热会话 / Stream 归档（见 docs/chat-memory.md）
CHAT_SESSION_TTL_SECONDS=604800
CHAT_COLD_START_TURNS=15
CHAT_STREAM_KEY=agent:chat:stream
CHAT_STREAM_DLQ_KEY=agent:chat:stream:dql
CHAT_STREAM_GROUP=chat-archiver
CHAT_STREAM_BATCH_SIZE=30
CHAT_STREAM_BLOCK_MS=5000

# Chat M2：裁剪 / 限流 / 锁 / Embedding 缓存 / 长期记忆 / 热配置
CHAT_TRIM_TRIGGER_TURNS=25
CHAT_TRIM_KEEP_TURNS=10
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_SESSION_LOCK_TTL_SECONDS=120
CHAT_EMBED_CACHE_TTL_SECONDS=604800
CHAT_MEMORY_COLLECTION=lujing_chat_memory
CHAT_TTL_SCAN_THRESHOLD_SECONDS=3600
CHAT_TTL_SCAN_CRON=0 3 * * *
HOT_CONFIG_HASH_KEY=hot:config

# JWT
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Local file storage
STORAGE_ROOT=./storage

# =========================
# LLM — AI 智能问答（必填才能对话）
# LLM / Embedding 已改为「模型管理」页面配置（写入数据库），运行时不再读取下列变量。
# 可整段删除；保留仅为兼容旧部署文档。
# =========================
# LLM_API_BASE=
# LLM_API_KEY=
# LLM_MODEL=
# EMBEDDING_API_BASE=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIM=

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lujing_knowledge

# Knowledge chunk / search
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=150
KB_SEARCH_TOP_K=5
KB_SEARCH_MIN_SCORE=0.0
