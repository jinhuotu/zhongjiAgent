# Application
APP_NAME=zhongji-agent
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
# CORS：开发可用 *（任意 Origin）；生产请改为前端域名白名单，逗号分隔
# 例：CORS_ORIGINS=https://ecm.example.com,https://www.example.com
CORS_ORIGINS=*

# Server
API_HOST=0.0.0.0
API_PORT=8800
AI_HOST=0.0.0.0
AI_PORT=8001
INGEST_HOST=0.0.0.0
INGEST_PORT=8002
MODEL_HOST=0.0.0.0
MODEL_PORT=8003

# MySQL — 应用只读 DATABASE_URL（MYSQL_* 仅对照 Compose，不被 Settings 读取）
# 与 deploy/docker-compose.yml 默认账号一致：zhongji / zhongji_dev
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=zhongji
# MYSQL_PASSWORD=zhongji_dev
# MYSQL_DATABASE=zhongji_agent
DATABASE_URL=mysql+asyncmy://zhongji:zhongji_dev@127.0.0.1:3306/zhongji_agent?charset=utf8mb4

# Redis（Docker Compose 默认宿主机端口 16379）
REDIS_URL=redis://127.0.0.1:16379/0

# Chat 热会话 / Stream 归档（见 docs/chat-memory.md）
CHAT_SESSION_TTL_SECONDS=604800
CHAT_COLD_START_TURNS=15
CHAT_STREAM_KEY=agent:chat:stream
CHAT_STREAM_DLQ_KEY=agent:chat:stream:dql
CHAT_STREAM_GROUP=chat-archiver
CHAT_STREAM_CONSUMER_PREFIX=worker
CHAT_STREAM_BATCH_SIZE=30
CHAT_STREAM_BLOCK_MS=5000

# Chat M2：裁剪 / 限流 / 锁 / Embedding 缓存 / 长期记忆 / 热配置
CHAT_TRIM_TRIGGER_TURNS=25
CHAT_TRIM_KEEP_TURNS=10
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# MCP stdio + 多轮 tool calling 可能超过 2 分钟；配合续租避免锁提前过期
CHAT_SESSION_LOCK_TTL_SECONDS=300
CHAT_EMBED_CACHE_TTL_SECONDS=604800
CHAT_MEMORY_COLLECTION=lujing_chat_memory
CHAT_TTL_SCAN_THRESHOLD_SECONDS=3600
CHAT_TTL_SCAN_CRON=0 3 * * *
HOT_CONFIG_HASH_KEY=hot:config
# 操作日志 / 登录日志保留天数（超时循环删除，默认 7 天）
AUDIT_LOG_RETENTION_DAYS=7

# JWT
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Local file storage
STORAGE_ROOT=./storage

# =========================
# LLM / Embedding 网关已改为「模型管理」页面配置（写入数据库）。
# 对话与向量化运行时不再读取 LLM_API_* / EMBEDDING_API_* / 模型名。
# =========================
# LLM_API_BASE=
# LLM_API_KEY=
# LLM_MODEL=
# EMBEDDING_API_BASE=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIM=
# Embedding 批处理仍从 .env 读取（模型管理只配网关）
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_CHARS=6000

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lujing_knowledge

# Knowledge chunk / search（改分块参数后需重新上传资料）
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_SEARCH_TOP_K=5
KB_SEARCH_MIN_SCORE=0.0
KB_SEARCH_CANDIDATE_MULTIPLIER=4
KB_SEARCH_KEYWORD_WEIGHT=0.4

# 知识库视频上传 / 语音转写（OpenAI 兼容 /v1/audio/transcriptions）
# 需本机 ffmpeg。本仓库 Whisper 映射宿主机 19100（避开 weitai 的 19000）：
# docker compose -f deploy/docker-compose.yml --profile asr up -d whisper
KB_UPLOAD_MAX_BYTES=209715200
KB_VIDEO_UPLOAD_MAX_BYTES=536870912
KB_VIDEO_ASR_TIMEOUT_SECONDS=7200
ASR_PROVIDER=openai
ASR_API_BASE=http://127.0.0.1:19100/v1
ASR_API_KEY=zhongji-dev-whisper
ASR_MODEL=base
ASR_LANGUAGE=zh
# 若改用云端 OpenAI：
# ASR_API_BASE=https://api.openai.com/v1
# ASR_API_KEY=sk-...
# ASR_MODEL=whisper-1

# 知识库图片上传 / OCR（默认本机 RapidOCR，无需外网）
# OCR_PROVIDER=rapidocr | aliyun | none
OCR_PROVIDER=rapidocr
OCR_TIMEOUT_SECONDS=120
# 若改用阿里云 OCR：
# OCR_PROVIDER=aliyun
# OCR_ACCESS_KEY_ID=
# OCR_ACCESS_KEY_SECRET=
# OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# 通用 MCP 历史天气默认厂区（scripts/seed_mcp_utility.py 会写入 MCP Server env）
# 调用 get_historical_weather 未传 lat/lon 时使用；请改成真实厂区坐标
# FACTORY_LAT=34.7466
# FACTORY_LON=113.6253
# FACTORY_NAME=郑州厂区

# MCP stdio 仓库根（可选）。不设则自动探测；非标准部署目录时再配置
# ZHONGJI_ROOT=/opt/zhongjiAgent
